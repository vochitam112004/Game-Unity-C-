--- !u!114 &1709947507
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1709947499}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fd9b7a125f32080468f1a32b6fa97c65, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TalkToLyThong
  autoTalkDistance: 10
  interactDistance: 2
  cutsceneDirector: {fileID: 1674916079}
  cutsceneCamera: {fileID: 591658725}
  autoTalkDialogues:
  - "N\xE0y ng\u01B0\u1EDDi l\u1EA1 \u01A1i!"
  afterCutsceneDialogues:
  - "L\xE0m xong vi\u1EC7c ch\u01B0a m\xE0 v\u1EC1 \u0111\xE2y?"
  autoTalkDuration: 3
  cutsceneDialogues:
  - name: Ly Thong
    sentence: "Tr\xE1ng s\u0129 v\xF5 ngh\u1EC7 th\u1EADt phi ph\xE0m! M\u1ED9t tay
      m\xE0 h\u1EA1 g\u1EE5c c\u1EA3 b\u1EA7y lang s\xF3i d\u1EEF t\u1EE3n ngo\xE0i
      b\xECa r\u1EEBng"
    duration: 3
    customCamera: {fileID: 591658725}
    animationTrigger: 
    isStopPoint: 0
  - name: Ly Thong
    sentence: "T\u1EA1i h\u1EA1 l\xE0 L\xFD Th\xF4ng, ng\u01B0\u1EDDi l\xE0ng n\xE0y"
    duration: 3
    customCamera: {fileID: 1148407694}
    animationTrigger: 
    isStopPoint: 0
  - name: Thach Sanh
    sentence: "Ch\xE0o L\xFD \u0111\u1EA1i ca. \u0110\u1EC7 l\xE0 Th\u1EA1ch Sanh,
      v\u1ED1n quen n\u1EBFp s\u1ED1ng s\u0103n b\u1EAFn. Th\u1EA5y th\xFA d\u1EEF
      c\u1EA3n \u0111\u01B0\u1EDDng n\xEAn ra tay tr\u1EEB h\u1ECDa th\xF4i"
    duration: 3
    customCamera: {fileID: 1733913521}
    animationTrigger: 
    isStopPoint: 0
  - name: Ly Thong
    sentence: "\xD4i, b\u1EA7y s\xF3i kia \u0111\xE2u nh\u1EB1m nh\xF2 g\xEC..."
    duration: 3
    customCamera: {fileID: 1746308504}
    animationTrigger: 
    isStopPoint: 0
  - name: Ly Thong
    sentence: "\u1EDE ng\xF4i mi\u1EBFu c\u1ED5 ph\xEDa T\xE2y B\u1EAFc, c\xF3 m\u1ED9t
      con Ch\u1EB1n Tinh v\xF4 c\xF9ng t\xE0n \xE1c"
    duration: 3
    customCamera: {fileID: 287095607}
    animationTrigger: 
    isStopPoint: 0
  - name: Thach Sanh
    sentence: "\u0110\xEAm nay \u0111\u1EBFn phi\xEAn l\xE0ng ta ph\u1EA3i n\u1ED9p
      m\u1EA1ng ng\u01B0\u1EDDi cho n\xF3. Nh\xECn \u0111\u1EC7 tr\u01B0\u1EE3ng
      ngh\u0129a, li\u1EC7u \u0111\u1EC7 c\xF3 th\u1EC3..."
    duration: 3
    customCamera: {fileID: 627506440}
    animationTrigger: 
    isStopPoint: 0
  - name: Thach Sanh
    sentence: "C\xF3 lo\xE0i y\xEAu qu\xE1i l\u1ED9ng h\xE0nh v\u1EADy sao! \u0110\u1EA1i
      ca \u0111\u1EEBng lo, \u0111\u1EC3 \u0111\u1EC7 \u0111i t\u1EDBi ng\xF4i mi\u1EBFu
      \u0111\xF3 tr\u1EEB h\u1EA1i cho b\xE1 t\xE1nh!"
    duration: 3
    customCamera: {fileID: 0}
    animationTrigger: 
    isStopPoint: 1
  interactUI: {fileID: 2014662487}
