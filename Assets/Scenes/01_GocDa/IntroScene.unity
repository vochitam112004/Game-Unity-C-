--- !u!114 &299781864
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 299781863}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8b50b5ba76f0a344e953283683e14594, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::StoryIntroManager
  slides:
  - image: {fileID: 21300000, guid: 6d882472b9842a245b42b060c20928a2, type: 3}
    dialogues:
    - sentence: "Ng\xF4i l\xE0ng y\xEAn b\xECnh b\u1ED7ng ch\xECm trong bi\u1EC3n
        l\u1EEDa"
      duration: 0
      customCamera: {fileID: 0}
      animationTrigger: 
      isStopPoint: 0
      voiceClip: {fileID: 8300000, guid: f42fea951c8ad014f9152a68ee51cf00, type: 3}
    - sentence: "T\u1EEB khu r\u1EEBng s\xE2u, Ch\u1EB1n Tinh xu\u1EA5t hi\u1EC7n,
        d\u1EABn theo b\u1EA7y s\xF3i hung t\u1EE3n\r\n"
      duration: 0
      customCamera: {fileID: 0}
      animationTrigger: 
      isStopPoint: 0
      voiceClip: {fileID: 8300000, guid: c5ed249bb6344c143b63258bd93a6dab, type: 3}
    - sentence: "Ti\u1EBFng g\u1EA7m vang l\xEAn, nh\xE0 c\u1EEDa b\u1ECB ph\xE1
        h\u1EE7y, d\xE2n l\xE0ng ho\u1EA3ng lo\u1EA1n b\u1ECF ch\u1EA1y"
      duration: 0
      customCamera: {fileID: 0}
      animationTrigger: 
      isStopPoint: 0
      voiceClip: {fileID: 8300000, guid: 01615e003e043c1439bd9070afce5338, type: 3}
    - sentence: "Kh\xF4ng ai c\xF3 th\u1EC3 ch\u1ED1ng l\u1EA1i ch\xFAng"
      duration: 0
      customCamera: {fileID: 0}
      animationTrigger: 
      isStopPoint: 0
      voiceClip: {fileID: 8300000, guid: 39a73f402999164469a850cccb847e8e, type: 3}
  - image: {fileID: 21300000, guid: d5c37c87832da7e46b732e6b5597e318, type: 3}
    dialogues:
    - sentence: "Gi\u1EEFa h\u1ED7n lo\u1EA1n, Ch\u1EB1n Tinh ti\u1EBFn th\u1EB3ng
        \u0111\u1EBFn ho\xE0ng cung"
      duration: 0
      customCamera: {fileID: 0}
      animationTrigger: 
      isStopPoint: 0
      voiceClip: {fileID: 8300000, guid: 109f8d4170a2cce46b8f446918cbaf91, type: 3}
    - sentence: "H\u1EAFn b\u1EAFt l\u1EA5y c\xF4ng ch\xFAa v\xE0 mang n\xE0ng v\xE0o
        hang s\xE2u trong r\u1EEBng"
      duration: 0
      customCamera: {fileID: 0}
      animationTrigger: 
      isStopPoint: 0
      voiceClip: {fileID: 8300000, guid: 8ffada4a44a44594f99127775f2374e3, type: 3}
    - sentence: "B\u1EA7y s\xF3i canh gi\u1EEF b\xEAn ngo\xE0i, bi\u1EBFn n\u01A1i
        \u0111\xF3 th\xE0nh v\xF9ng \u0111\u1EA5t ch\u1EBFt"
      duration: 0
      customCamera: {fileID: 0}
      animationTrigger: 
      isStopPoint: 0
      voiceClip: {fileID: 8300000, guid: 4c7215b40a6847b4e993a722a9be5c9a, type: 3}
    - sentence: "Hy v\u1ECDng c\u1EE7a v\u01B0\u01A1ng qu\u1ED1c d\u1EA7n t\u1EAFt"
      duration: 0
      customCamera: {fileID: 0}
      animationTrigger: 
      isStopPoint: 0
      voiceClip: {fileID: 8300000, guid: 08d84a96634cd8140add908f215258ef, type: 3}
  - image: {fileID: 21300000, guid: c34cc513770fa494482c31049ebeb151, type: 3}
    dialogues:
    - sentence: "Nghe tin d\u1EEF, Th\u1EA1ch Sanh l\xEAn \u0111\u01B0\u1EDDng"
      duration: 0
      customCamera: {fileID: 0}
      animationTrigger: 
      isStopPoint: 0
      voiceClip: {fileID: 8300000, guid: 1fbb2de749e04104cafac835ead856f4, type: 3}
    - sentence: "Ch\xE0ng ti\u1EBFn v\xE0o khu r\u1EEBng nguy hi\u1EC3m, n\u01A1i
        \u0111\u1EA7y r\u1EABy c\xE1i ch\u1EBFt"
      duration: 0
      customCamera: {fileID: 0}
      animationTrigger: 
      isStopPoint: 0
      voiceClip: {fileID: 8300000, guid: f2095506860c4df4fa62233281da077d, type: 3}
    - sentence: "Nh\u01B0ng tr\u01B0\u1EDBc khi ch\u1EA1m tr\xE1n Ch\u1EB1n Tinh\u2026"
      duration: 0
      customCamera: {fileID: 0}
      animationTrigger: 
      isStopPoint: 0
      voiceClip: {fileID: 8300000, guid: f8fc2fd44da3d174181014a70385cf75, type: 3}
    - sentence: "B\u1EA7y s\xF3i kh\xE1t m\xE1u \u0111ang ch\u1EDD s\u1EB5n"
      duration: 0
      customCamera: {fileID: 0}
      animationTrigger: 
      isStopPoint: 0
      voiceClip: {fileID: 8300000, guid: b1c95d75b60229a44b8cb927119a25e0, type: 3}
  - image: {fileID: 21300000, guid: 1489dc2e246d5ff428bd5b5edf5782d8, type: 3}
    dialogues:
    - sentence: "Sau khi v\u01B0\u1EE3t qua b\u1EA7y s\xF3i, Th\u1EA1ch Sanh ti\u1EBFn
        \u0111\u1EBFn hang \u1ED5 "
      duration: 0
      customCamera: {fileID: 0}
      animationTrigger: 
      isStopPoint: 0
      voiceClip: {fileID: 8300000, guid: 7f59ad65b5e1d7243861b4d9ab84ddff, type: 3}
    - sentence: "R\xECu \u0111\u1ED1i \u0111\u1EA7u m\xF3ng vu\u1ED1t. Con ng\u01B0\u1EDDi
        \u0111\u1ED1i \u0111\u1EA7u qu\xE1i v\u1EADt"
      duration: 0
      customCamera: {fileID: 0}
      animationTrigger: 
      isStopPoint: 0
      voiceClip: {fileID: 8300000, guid: d1f568ffa368edf46b09f1f70ca0a96c, type: 3}
    - sentence: "Ch\u1EC9 m\u1ED9t k\u1EBB c\xF3 th\u1EC3 \u0111\u1EE9ng v\u1EEFng\u2026"
      duration: 0
      customCamera: {fileID: 0}
      animationTrigger: 
      isStopPoint: 0
      voiceClip: {fileID: 8300000, guid: 591e1e890369ff646b3af782e23e89a7, type: 3}
    - sentence: "V\xE0 s\u1ED1 ph\u1EADn c\xF4ng ch\xFAa n\u1EB1m trong tay ng\u01B0\u1EDDi
        \u0111\xF3!"
      duration: 0
      customCamera: {fileID: 0}
      animationTrigger: 
      isStopPoint: 0
      voiceClip: {fileID: 8300000, guid: 2b1ede6f641133b4797b89788acfc4b3, type: 3}
  backgroundImage: {fileID: 343814090}
  nextSceneName: Chuong1_GocDa
  loadingScreenPanel: {fileID: 1457687765}
  loadingProgressBar: {fileID: 0}
  pressAnyKeyText: {fileID: 0}
